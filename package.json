{
  "name": "flipflopgame",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "flask --app app run --debug",
    "host": "ssh -p 443 -o ServerAliveInterval=30 -R0:127.0.0.1:5000 a.pinggy.io",
    "watch": "chokidar 'index.html' 'src/**/*.ts' 'src/**/*.tsx' 'src/**/*.scss' -c 'yarn build --minify=false'",
    "lint": "eslint . && stylelint 'src/**/*.scss'",
    "lint:fix": "eslint . --fix && stylelint 'src/**/*.scss' --fix",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pip:install": "pip install -r requirements.txt",
    "pip:freeze": "pip freeze > requirements.txt"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.5",
    "chokidar-cli": "^3.0.0",
    "clsx": "^2.1.1",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.23.1",
    "react-toastify": "^10.0.5",
    "sass": "^1.77.2",
    "stylelint": "^16.6.1",
    "stylelint-config-recess-order": "^5.0.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8"
  }
}
