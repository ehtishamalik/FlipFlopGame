{
  "name": "flipflopgame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "python app.py",
    "watch": "yarn build && chokidar 'src/**/*.ts' 'src/**/*.tsx' 'src/**/*.scss' -c 'yarn build'",
    "lint": "yarn format:scss && yarn format:ts && yarn lint:ts",
    "lint:ts": "eslint . --ext ts,tsx",
    "format:scss": "stylelint 'src/**/*.scss' --fix",
    "format:ts": "prettier --write 'src/**/*.{ts,tsx,md}' --config ./.prettierrc.json",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "freeze": "pip freeze > requirements.txt",
    "envup": "source .venv/bin/activate",
    "envdown": "source deactivate"
  },
  "dependencies": {
    "chokidar-cli": "^3.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.77.2",
    "stylelint": "^16.6.0",
    "stylelint-config-recess-order": "^5.0.1",
    "stylelint-config-standard": "^36.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
