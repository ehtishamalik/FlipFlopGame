{
  "name": "flipflopgame",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "flask --app app run",
    "server:debug": "flask --app app run --debug",
    "lint:ts": "eslint . --ext ts,tsx",
    "format:scss": "stylelint 'src/**/*.scss'",
    "format:ts": "prettier --write 'src/**/*.{ts,tsx,md}' --config ./.prettierrc.json",
    "lint": "yarn format:ts && yarn format:scss --fix && yarn lint:ts --fix",
    "build": "tsc && vite build",
    "watch": "chokidar 'src/**/*.ts' 'index.html' 'src/**/*.tsx' 'src/**/*.scss' -c 'yarn build'",
    "preview": "vite preview",
    "pip:install": "pip install -r requirements.txt",
    "pip:freeze": "pip freeze > requirements.txt"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.5",
    "chokidar-cli": "^3.0.0",
    "clsx": "^2.1.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.23.1",
    "sass": "^1.77.2",
    "stylelint": "^16.6.1",
    "stylelint-config-recess-order": "^5.0.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
